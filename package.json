{
  "name": "dom-mutation-recorder",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Lossless DOM recording and AI export toolkit for browser testing and extensions",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:browser-bootstrap && npm run build:extension-core",
    "build:browser-bootstrap": "node scripts/build-browser-bootstrap.mjs",
    "build:extension-core": "node scripts/copy-core-for-extension.mjs",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:unit": "vitest run tests/core.test.ts",
    "test:playwright": "vitest run tests/playwright.test.ts",
    "changeset:add": "changeset",
    "changeset:version": "changeset version",
    "cli": "tsx apps/cli/src/index.ts",
    "demo": "tsx apps/demo/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "license": "MIT",
  "author": "Juha Itäleino <jsilvanus@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsilvanus/dom-mutation-recorder.git"
  },
  "main": "./dist/packages/core/src/index.js",
  "types": "./dist/packages/core/src/index.d.ts",
  "bin": {
    "domrec": "./dist/apps/cli/src/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/packages/core/src/index.d.ts",
      "import": "./dist/packages/core/src/index.js"
    },
    "./core": {
      "types": "./dist/packages/core/src/index.d.ts",
      "import": "./dist/packages/core/src/index.js"
    },
    "./playwright": {
      "types": "./dist/packages/playwright/src/index.d.ts",
      "import": "./dist/packages/playwright/src/index.js"
    },
    "./exporter": {
      "types": "./dist/packages/exporter/src/index.d.ts",
      "import": "./dist/packages/exporter/src/index.js"
    },
    "./chrome": {
      "types": "./dist/packages/chrome/src/index.d.ts",
      "import": "./dist/packages/chrome/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^20.0.1",
    "@types/node": "^22.18.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.56.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.4"
  }
}
